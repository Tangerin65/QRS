.workbench-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.heading-scan {
  padding: 12rpx 18rpx;
  color: #285fa6;
  font-size: 26rpx;
}

.account-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 80rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #ddd;
}

.account-name {
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.account-role {
  flex: 1;
  min-width: 0;
  color: #666;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.application-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx 12rpx;
}

.application-item {
  flex: 0 0 25%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.application-item-pressed {
  background-color: #f4f6f9;
}

.application-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
}

.application-label {
  max-width: 100%;
}

.guide-item {
  margin: 0 24rpx;
  border-top: 1rpx solid #eee;
}

.guide-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 84rpx;
  padding: 12rpx 0;
}

.guide-answer {
  display: block;
  padding: 0 0 18rpx;
  color: #666;
  font-size: 24rpx;
  line-height: 1.7;
}

.expanded {
  transform: rotate(90deg);
}
