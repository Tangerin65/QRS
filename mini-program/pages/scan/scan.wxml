<view class="page scan-page">
  <view class="mode-tabs">
    <button class="mode-tab {{mode === 'bind' ? 'selected' : ''}}" data-mode="bind" disabled="{{busy || scanning}}" bindtap="changeMode">账号绑定</button>
    <button class="mode-tab {{mode === 'pc' ? 'selected' : ''}}" data-mode="pc" disabled="{{busy || scanning}}" bindtap="changeMode">电脑登录</button>
  </view>
  <view class="scan-heading">
    <text class="page-title">{{mode === 'pc' ? '安全登录电脑端' : '绑定你的平台账号'}}</text>
    <text class="page-subtitle">{{mode === 'pc' ? '扫描电脑端动态二维码，核对后确认' : '扫描管理员提供的个人账号二维码'}}</text>
  </view>
  <view wx:if="{{!configured}}" class="connection-note">服务暂未接入，暂不能完成绑定或登录。</view>
  <view class="scan-card card">
    <block wx:if="{{!pcReady && !pcDone && !pcCancelled && !userNo}}">
      <view class="scan-frame">
        <view class="corner corner-tl"></view><view class="corner corner-tr"></view>
        <view class="corner corner-bl"></view><view class="corner corner-br"></view>
        <image class="scan-frame-icon" src="/assets/icons/scan.png" mode="aspectFit" />
        <text class="scan-frame-text">{{mode === 'pc' ? '电脑端登录二维码' : '个人账号二维码'}}</text>
      </view>
      <button class="primary-button" bindtap="startScan" loading="{{busy || scanning}}" disabled="{{busy || scanning}}">打开扫一扫</button>
      <text class="camera-note">点击后使用相机扫描二维码</text>
    </block>
    <view wx:if="{{mode === 'bind' && userNo}}" class="bind-result">
      <view class="result-icon tone-scan"><image src="/assets/icons/profile.png" mode="aspectFit" /></view>
      <text class="pc-title">确认绑定此账号？</text>
      <view class="account-number"><text class="result-label">平台账号</text><text class="result-value">{{userNo}}</text></view>
      <text class="result-description">请核对编号，确认二维码属于本人。</text>
      <button class="primary-button confirm-button" bindtap="confirmBind" loading="{{busy}}" disabled="{{busy}}">确认绑定本人账号</button>
      <button class="text-button" bindtap="startScan" disabled="{{busy}}">重新扫描</button>
    </view>
    <view wx:if="{{pcReady}}" class="pc-request">
      <view class="result-icon tone-pc"><image src="/assets/icons/pc.png" mode="aspectFit" /></view>
      <text class="pc-title">是否允许电脑登录？</text>
      <view class="device-info">
        <view class="device-row"><text class="device-label">账号</text><text class="device-value">{{accountName}}</text></view>
        <view class="device-row"><text class="device-label">设备</text><text class="device-value">{{deviceName}}</text></view>
        <view class="device-row"><text class="device-label">位置</text><text class="device-value">{{location}}</text></view>
      </view>
      <text class="countdown">{{secondsLeft}} 秒内有效</text>
      <text class="pc-warning">请确认是本人操作，设备或位置不符时请拒绝。</text>
      <button class="primary-button confirm-button" loading="{{busy}}" disabled="{{busy || secondsLeft === 0}}" bindtap="confirmPc">确认登录</button>
      <button class="secondary-button confirm-button" disabled="{{busy}}" bindtap="cancelPc">拒绝登录</button>
    </view>
    <view wx:if="{{pcDone || pcCancelled}}" class="pc-request">
      <view class="result-icon {{pcDone ? 'tone-pc' : 'tone-logout'}}"><image src="/assets/icons/{{pcDone ? 'success' : 'cancel'}}.png" mode="aspectFit" /></view>
      <text class="pc-title">{{pcDone ? '已确认电脑登录' : '已拒绝本次登录'}}</text>
      <text class="result-description">{{pcDone ? '请返回电脑端继续使用。' : '本次请求已取消，可重新扫描其他二维码。'}}</text>
      <button class="secondary-button confirm-button" bindtap="startScan">扫描其他二维码</button>
    </view>
    <request-state wx:if="{{status === 'loading'}}" status="loading" />
  </view>
  <request-state wx:if="{{status === 'error'}}" status="error" message="{{message}}" retry-text="重新扫码" bind:retry="retry" />
  <view class="scan-help">
    <text>{{mode === 'pc' ? '二维码过期后，请在电脑端刷新。' : '更换绑定请联系管理员解除原绑定。'}}</text>
    <button class="text-button" disabled="{{busy || scanning}}" bindtap="goProfile">前往个人中心 ›</button>
  </view>
</view>
