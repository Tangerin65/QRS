.scan-page {
  padding-top: 20rpx;
}

/* M12-B 绑定口令输入区：首次绑定要校验平台账号口令，避免仅凭编号占用他人账号 */
.password-field {
  margin-top: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #e3e9f2;
  border-radius: 16rpx;
  background: #f8fafd;
  text-align: left;
}

.password-label {
  display: block;
  margin-bottom: 12rpx;
  color: #46536a;
  font-size: 25rpx;
  font-weight: 500;
}

.password-input {
  width: 100%;
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d7dfeb;
  border-radius: 12rpx;
  background: #fff;
  color: #2c3a4f;
  font-size: 27rpx;
}

.password-note {
  display: block;
  margin-top: 12rpx;
  color: #9aa4b4;
  font-size: 21rpx;
  line-height: 1.6;
}

.mode-tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 6rpx;
  background: #e9edf4;
}

.mode-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  border-radius: 4rpx;
  color: #666;
  font-size: 26rpx;
}

.mode-tab.selected {
  background: #fff;
  color: #2e65af;
  font-weight: 500;
}

.scan-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.scan-instruction {
  display: block;
  margin-bottom: 20rpx;
  color: #555;
  line-height: 1.6;
}

.scan-card .primary-button, .scan-card .secondary-button {
  width: 100%;
}

.pc-title {
  display: block;
  margin-bottom: 26rpx;
  color: #2a384e;
  font-size: 32rpx;
  font-weight: 600;
}

.device-info, .account-number {
  padding: 12rpx 24rpx;
  border-radius: 4rpx;
  background: #f6f8fb;
  text-align: left;
}

.device-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
}

.device-label {
  flex: 0 0 62rpx;
  color: #666;
}

.device-value {
  flex: 1;
  min-width: 0;
  color: #47556a;
  overflow-wrap: anywhere;
}

.countdown {
  display: block;
  margin-top: 18rpx;
  color: #555;
  font-size: 24rpx;
}

.pc-warning {
  display: block;
  margin: 22rpx 0 8rpx;
  color: #aa793e;
  font-size: 24rpx;
  line-height: 1.7;
}

.confirm-button {
  margin-top: 20rpx;
}

.result-description {
  display: block;
  margin-top: 22rpx;
  color: #8a96a8;
  font-size: 25rpx;
  line-height: 1.7;
}

.result-label {
  display: block;
  margin: 12rpx 0;
  color: #929eae;
  font-size: 23rpx;
}

.result-value {
  display: block;
  padding-bottom: 14rpx;
  color: #344154;
  font-size: 34rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.text-button {
  padding: 24rpx 12rpx 8rpx;
  color: #2e65af;
  font-size: 25rpx;
}

.scan-help {
  padding: 28rpx 10rpx;
  color: #666;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.scan-help .text-button {
  display: block;
  margin: 0 auto;
  padding-top: 20rpx;
}
