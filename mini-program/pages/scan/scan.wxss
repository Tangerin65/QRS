.scan-page {
  padding-top: 20rpx;
}

.mode-tabs {
  display: flex;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #e9edf4;
}

.mode-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  border-radius: 10rpx;
  color: #7c889a;
  font-size: 26rpx;
}

.mode-tab.selected {
  background: #fff;
  color: #4779e8;
  font-weight: 500;
}

.scan-heading {
  padding: 38rpx 4rpx 30rpx;
}

.scan-heading .page-title {
  font-size: 36rpx;
}

.scan-card {
  padding: 36rpx 32rpx 28rpx;
  text-align: center;
}

.scan-card .primary-button, .scan-card .secondary-button {
  width: 100%;
}

.scan-frame {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  max-width: 100%;
  height: 328rpx;
  margin: 10rpx auto 36rpx;
  background: #f6f8fd;
  border-radius: 12rpx;
}

.scan-frame-icon {
  width: 110rpx;
  height: 110rpx;
  opacity: .65;
}

.scan-frame-text {
  margin-top: 26rpx;
  color: #8f9db4;
  font-size: 24rpx;
}

.corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #6e92e9;
  border-style: solid;
}

.corner-tl {
  top: 0;
  left: 0;
  border-width: 4rpx 0 0 4rpx;
  border-top-left-radius: 10rpx;
}

.corner-tr {
  top: 0;
  right: 0;
  border-width: 4rpx 4rpx 0 0;
  border-top-right-radius: 10rpx;
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 4rpx 4rpx;
  border-bottom-left-radius: 10rpx;
}

.corner-br {
  bottom: 0;
  right: 0;
  border-width: 0 4rpx 4rpx 0;
  border-bottom-right-radius: 10rpx;
}

.camera-note {
  display: block;
  margin-top: 20rpx;
  color: #9aa4b3;
  font-size: 22rpx;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  margin: 10rpx auto 28rpx;
  border-radius: 34rpx;
}

.result-icon image {
  width: 64rpx;
  height: 64rpx;
}

.pc-title {
  display: block;
  margin-bottom: 26rpx;
  color: #2a384e;
  font-size: 32rpx;
  font-weight: 600;
}

.device-info, .account-number {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #f6f8fb;
  text-align: left;
}

.device-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
}

.device-label {
  flex: 0 0 62rpx;
  color: #929eae;
}

.device-value {
  flex: 1;
  min-width: 0;
  color: #47556a;
  overflow-wrap: anywhere;
}

.countdown {
  display: inline-block;
  margin-top: 26rpx;
  padding: 7rpx 18rpx;
  border-radius: 8rpx;
  background: #edf3ff;
  color: #4779e8;
  font-size: 23rpx;
}

.pc-warning {
  display: block;
  margin: 22rpx 0 8rpx;
  color: #aa793e;
  font-size: 24rpx;
  line-height: 1.7;
}

.confirm-button {
  margin-top: 20rpx;
}

.result-description {
  display: block;
  margin-top: 22rpx;
  color: #8a96a8;
  font-size: 25rpx;
  line-height: 1.7;
}

.result-label {
  display: block;
  margin: 12rpx 0;
  color: #929eae;
  font-size: 23rpx;
}

.result-value {
  display: block;
  padding-bottom: 14rpx;
  color: #344154;
  font-size: 34rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.text-button {
  padding: 24rpx 12rpx 8rpx;
  color: #4779e8;
  font-size: 25rpx;
}

.scan-help {
  padding: 28rpx 10rpx;
  color: #97a0af;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.scan-help .text-button {
  display: block;
  margin: 0 auto;
  padding-top: 20rpx;
}
