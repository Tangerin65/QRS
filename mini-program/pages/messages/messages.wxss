.message-tabs {
  display: flex;
  padding: 8rpx;
}

.message-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  border-radius: 16rpx;
  color: #94a3b8;
  font-size: 27rpx;
}

.message-tab.active {
  background: #eff6ff;
  color: #2563eb;
  font-weight: 700;
}

.tab-count {
  min-width: 32rpx;
  padding: 2rpx 8rpx;
  border-radius: 99rpx;
  background: #e2e8f0;
  color: #64748b;
  font-size: 20rpx;
  text-align: center;
}

.message-tab.active .tab-count {
  background: #dbeafe;
  color: #2563eb;
}

.handoff-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  padding: 64rpx 42rpx;
  text-align: center;
}

.handoff-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 98rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 54rpx;
}

.handoff-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
}

.handoff-desc {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.7;
}
