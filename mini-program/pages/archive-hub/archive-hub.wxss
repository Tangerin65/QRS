@import "../archiving/common.wxss";

.hub-head {
  padding: 8rpx 4rpx 4rpx;
}

.summary {
  display: flex;
  margin-top: 18rpx;
  padding: 22rpx 0;
  border: 1rpx solid #e1e4e8;
  border-radius: 6rpx;
  background: #fff;
}

.summary-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2d3d;
  line-height: 1.2;
}

.summary-num.bad {
  color: #c04040;
}

.summary-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8794a6;
}

.hub-item {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
}

.hub-item-pressed {
  background: #f8fafd;
}

.glyph {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.glyph-blue { background: #eaf3ff; color: #2e65af; }
.glyph-teal { background: #e8f6f4; color: #1f8a78; }
.glyph-violet { background: #f2eefc; color: #6a4fc4; }
.glyph-amber { background: #fff4e6; color: #c07a12; }

.hub-copy {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.hub-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hub-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #28374d;
}

.hub-value {
  font-size: 23rpx;
  color: #2e65af;
}

.hub-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7a8999;
  line-height: 1.5;
}

.hub-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa6b5;
  line-height: 1.5;
}

.hub-home {
  margin-top: 20rpx;
}
