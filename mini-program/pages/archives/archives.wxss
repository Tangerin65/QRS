.placeholder-page {
  background: linear-gradient(180deg, #eef5ff 0, #f7f9fc 380rpx);
}

.placeholder-hero {
  padding: 24rpx 8rpx 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx 12rpx 24rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  color: #334155;
  font-size: 26rpx;
}

.search-button {
  min-width: 116rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 64rpx;
}

.handoff-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  padding: 64rpx 42rpx;
  text-align: center;
}

.handoff-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  height: 98rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #e0e7ff;
  color: #4f46e5;
  font-size: 56rpx;
}

.handoff-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
}

.handoff-desc {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.7;
}
