<view class="page placeholder-page">
  <view class="placeholder-heading">
    <view class="small-icon tone-archives"><image src="/assets/icons/archives.png" mode="aspectFit" /></view>
    <view><text class="page-title">档案查询</text><text class="page-subtitle">检索与阅览授权档案</text></view>
  </view>
  <view class="empty-service card">
    <image class="empty-illustration" src="/assets/icons/empty-archives.png" mode="aspectFit" />
    <text class="empty-title">档案查询暂未开放</text>
    <text class="empty-description">服务开放后，可在这里检索档案、查看档案信息及附件。</text>
    <button class="secondary-button" bindtap="goHome">返回工作台</button>
  </view>
  <app-tabbar active="archives"></app-tabbar>
</view>
