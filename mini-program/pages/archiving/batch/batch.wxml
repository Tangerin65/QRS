<view class="page">
  <view class="list-head">
    <text class="list-title">归档批次</text>
    <text class="list-sub">共 {{total}} 个批次 · 点条目查看来源、失败原因与逐件明细</text>
  </view>

  <view class="chips">
    <view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'chip-on' : ''}}"
          data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>

  <request-state wx:if="{{status === 'loading'}}" status="loading" />
  <request-state wx:elif="{{status === 'error'}}" status="error" message="{{error}}" bind:retry="retry" />
  <request-state wx:elif="{{status === 'empty'}}" status="empty" message="当前筛选下没有批次" />

  <block wx:else>
    <view wx:for="{{rows}}" wx:key="batchNo" class="card item">
      <view data-id="{{item.batchNo}}" bindtap="toggle">
        <view class="item-head">
          <text class="item-code">{{item.batchNo}}</text>
          <text class="tag tag-{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <text class="item-title">{{item.name}}</text>
        <view class="tags">
          <text class="tag">来源：{{item.sourceLabel || '未登记'}}</text>
          <text class="tag">共 {{item.total}} 件</text>
          <text wx:if="{{item.retentionText}}" class="tag">{{item.retentionText}}</text>
        </view>
        <view class="item-foot">
          <text class="foot-note">{{item.updatedAt}} · 申请人 {{item.applicantName || '未登记'}}</text>
          <text class="expand">{{expandedId === item.batchNo ? '收起' : '查看明细'}}</text>
        </view>
      </view>

      <view wx:if="{{expandedId === item.batchNo}}" class="detail">
        <view class="kv">
          <text class="kv-key">批次来源</text>
          <text class="kv-val">{{item.sourceLabel || '未登记'}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">来源说明</text>
          <text class="kv-val">{{item.sourceDetail || '未登记'}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">成功 / 失败</text>
          <text class="kv-val">{{item.success}} / {{item.fail}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">保管库位</text>
          <text class="kv-val">{{item.locationCode || '未登记'}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">创建时间</text>
          <text class="kv-val">{{item.createdAt}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">最近更新</text>
          <text class="kv-val">{{item.updatedAt}}</text>
        </view>

        <block wx:if="{{item.hasReturnedInfo}}">
          <text class="detail-label">失败原因</text>
          <view class="returned-box">
            {{item.returnedReason || '见逐件明细'}}
            <text wx:if="{{item.returnedMeta}}" class="returned-meta">{{item.returnedMeta}}</text>
          </view>
        </block>

        <text class="detail-label">逐件明细</text>
        <text wx:if="{{detailStatus === 'loading'}}" class="check-msg">明细加载中…</text>
        <text wx:elif="{{detailStatus === 'error'}}" class="action-error">{{detailError}}</text>
        <block wx:elif="{{detail && detail.items.length}}">
          <view wx:for="{{detail.items}}" wx:for-item="entry" wx:key="archiveCode" class="check">
            <view class="check-main">
              <text class="check-name">{{entry.archiveCode}}</text>
              <text class="check-msg">{{entry.title}}{{entry.reason ? '：' + entry.reason : ''}}</text>
            </view>
            <text class="tag tag-{{entry.itemResult === 'OK' ? 'pass' : 'fail'}}">{{entry.itemResult === 'OK' ? '成功' : '失败'}}</text>
          </view>
        </block>

        <view class="actions">
          <button wx:if="{{item.canRetry}}" class="mini-button mini-primary" data-id="{{item.batchNo}}"
                  data-action="retry" bindtap="runAction" disabled="{{actionId === item.batchNo}}">重新组批</button>
        </view>
        <text wx:if="{{actionError && expandedId === item.batchNo}}" class="action-error">{{actionError}}</text>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="secondary-button more-button" bindtap="loadMore"
            loading="{{loadingMore}}">加载更多</button>
  </block>
</view>
