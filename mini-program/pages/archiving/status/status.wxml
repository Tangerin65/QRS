<view class="page">
  <view class="list-head">
    <text class="list-title">归档状态查询</text>
    <text class="list-sub">按档号或题名检索归档进度、保管期限状态与检查结果</text>
  </view>

  <view class="search">
    <input class="search-input" value="{{keyword}}" placeholder="输入档号或题名"
           confirm-type="search" bindinput="onKeyword" bindconfirm="search" />
    <button class="search-button" bindtap="search">查询</button>
  </view>

  <view class="chips">
    <view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'chip-on' : ''}}"
          data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>

  <request-state wx:if="{{status === 'loading'}}" status="loading" />
  <request-state wx:elif="{{status === 'error'}}" status="error" message="{{error}}" bind:retry="retry" />
  <request-state wx:elif="{{status === 'empty'}}" status="empty" message="没有匹配的档案，换个档号或题名再试" />

  <block wx:else>
    <view wx:for="{{rows}}" wx:key="archiveCode" class="card item">
      <view data-id="{{item.archiveCode}}" bindtap="toggle">
        <view class="item-head">
          <text class="item-code">{{item.archiveCode}}</text>
          <text class="tag tag-{{item.archiveStatus}}">{{item.statusLabel}}</text>
        </view>
        <text class="item-title">{{item.title}}</text>
        <view class="tags">
          <text class="tag tag-{{item.retention.state}}">{{item.retention.label}}</text>
          <text class="tag tag-{{item.mediumTone}}">介质 {{item.mediumText}}</text>
          <text class="tag tag-{{item.check.tone}}">通过 {{item.check.passed}}/{{item.check.total}}</text>
        </view>
        <view class="item-foot">
          <text class="foot-note">{{item.locationText}} · 最近检查 {{item.lastCheckAt}}</text>
          <text class="expand">{{expandedId === item.archiveCode ? '收起' : '查看明细'}}</text>
        </view>
      </view>

      <view wx:if="{{expandedId === item.archiveCode}}" class="detail">
        <text class="detail-label">逐项检查结果</text>
        <view wx:for="{{item.checks}}" wx:for-item="check" wx:key="code" class="check">
          <view class="check-main">
            <text class="check-name">{{check.label}}</text>
            <text wx:if="{{check.detail}}" class="check-msg">{{check.detail}}</text>
          </view>
          <text class="tag tag-{{check.passed ? 'pass' : 'fail'}}">{{check.passed ? '通过' : '未通过'}}</text>
        </view>

        <view class="kv">
          <text class="kv-key">保管期限</text>
          <text class="kv-val">{{item.retention.label}}{{item.retention.message ? '（' + item.retention.message + '）' : ''}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">所属批次</text>
          <text class="kv-val">{{item.batchText}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">电子存储位置</text>
          <text class="kv-val">{{item.electronicText}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">归档人</text>
          <text class="kv-val">{{item.archivedByText}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">保管库位</text>
          <text class="kv-val">{{item.locationText}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">归档时间</text>
          <text class="kv-val">{{item.archivedText}}</text>
        </view>

        <view class="actions">
          <button class="mini-button mini-secondary" data-id="{{item.archiveCode}}" data-action="recheck"
                  bindtap="runAction" disabled="{{actionId === item.archiveCode}}">重新检查</button>
        </view>
        <text wx:if="{{reportNotice && reportNoticeId === item.archiveCode}}" class="report-notice">{{reportNotice}}</text>
        <text wx:if="{{actionError && expandedId === item.archiveCode}}" class="action-error">{{actionError}}</text>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="secondary-button more-button" bindtap="loadMore"
            loading="{{loadingMore}}">加载更多</button>
  </block>
</view>
