<view class="page">
  <view class="list-head">
    <text class="list-title">库位</text>
    <text class="list-sub">共 {{total}} 个库位 · 点条目查看介质与电子存储位置</text>
  </view>

  <view class="chips">
    <view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'chip-on' : ''}}"
          data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>

  <request-state wx:if="{{status === 'loading'}}" status="loading" />
  <request-state wx:elif="{{status === 'error'}}" status="error" message="{{error}}" bind:retry="retry" />
  <request-state wx:elif="{{status === 'empty'}}" status="empty" message="当前介质下没有库位" />

  <block wx:else>
    <view wx:for="{{rows}}" wx:key="id" class="card item">
      <view data-id="{{item.id}}" bindtap="toggle">
        <view class="item-head">
          <text class="item-code">{{item.code}}</text>
          <text class="tag tag-{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <text class="item-title">{{item.house}}</text>
        <view class="tags">
          <text class="tag">介质：{{item.mediumLabel}}</text>
          <text class="tag">占用 {{item.usageText}}</text>
        </view>
        <view class="bar">
          <view class="bar-fill {{item.percent >= 100 ? 'bar-fill-full' : ''}}" style="width: {{item.percent}}%;"></view>
        </view>
        <view class="item-foot">
          <text class="foot-note">{{item.position}}</text>
          <text class="expand">{{expandedId === item.id ? '收起' : '查看明细'}}</text>
        </view>
      </view>

      <view wx:if="{{expandedId === item.id}}" class="detail">
        <view class="kv">
          <text class="kv-key">库位代码</text>
          <text class="kv-val">{{item.code}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">所属库房</text>
          <text class="kv-val">{{item.house}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">排架位置</text>
          <text class="kv-val">{{item.position}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">存储介质</text>
          <text class="kv-val">{{item.mediumLabel}}</text>
        </view>
        <view class="kv" wx:if="{{item.electronicPath}}">
          <text class="kv-key">电子存储位置</text>
          <text class="kv-val">{{item.electronicPath}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">容量占用</text>
          <text class="kv-val">{{item.usageText}}（{{item.percent}}%）</text>
        </view>
        <view class="kv" wx:if="{{item.note}}">
          <text class="kv-key">备注</text>
          <text class="kv-val">{{item.note}}</text>
        </view>

        <block wx:if="{{item.archives.length}}">
          <text class="detail-label">当前存放档案</text>
          <view class="tags">
            <text wx:for="{{item.archives}}" wx:for-item="archive" wx:key="code" class="tag">{{archive.code}}</text>
          </view>
        </block>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="secondary-button more-button" bindtap="loadMore"
            loading="{{loadingMore}}">加载更多</button>
    <text class="note">数据来自接口桩（MOCK），库位容量与电子存储节点信息待后端提供。</text>
  </block>
</view>
