<view class="page">
  <view class="list-head">
    <text class="list-title">库位</text>
    <text class="list-sub">共 {{total}} 个库位 · 点条目查看介质、容量与电子存储位置</text>
  </view>

  <view class="chips">
    <view wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'chip-on' : ''}}"
          data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>

  <request-state wx:if="{{status === 'loading'}}" status="loading" />
  <request-state wx:elif="{{status === 'error'}}" status="error" message="{{error}}" bind:retry="retry" />
  <request-state wx:elif="{{status === 'empty'}}" status="empty" message="当前介质下没有库位" />

  <block wx:else>
    <view wx:for="{{rows}}" wx:key="locationCode" class="card item">
      <view data-id="{{item.locationCode}}" bindtap="toggle">
        <view class="item-head">
          <text class="item-code">{{item.locationCode}}</text>
          <text class="tag tag-{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <text class="item-title">{{item.locationName}}</text>
        <view class="tags">
          <text class="tag">介质：{{item.mediumLabel || '未登记'}}</text>
          <text class="tag">占用 {{item.capacityText}}</text>
        </view>
        <view class="bar">
          <view class="bar-fill {{item.percentClamped >= 100 ? 'bar-fill-full' : ''}}"
                style="width: {{item.percentClamped}}%;"></view>
        </view>
        <view class="item-foot">
          <text class="foot-note">{{item.levelPath}}</text>
          <text class="expand">{{expandedId === item.locationCode ? '收起' : '查看明细'}}</text>
        </view>
      </view>

      <view wx:if="{{expandedId === item.locationCode}}" class="detail">
        <view class="kv">
          <text class="kv-key">库位代码</text>
          <text class="kv-val">{{item.locationCode}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">库位名称</text>
          <text class="kv-val">{{item.locationName}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">层级路径</text>
          <text class="kv-val">{{item.levelPath}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">所属库房</text>
          <text class="kv-val">{{item.house}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">存储介质</text>
          <text class="kv-val">{{item.mediumLabel || '未登记'}}</text>
        </view>
        <view class="kv" wx:if="{{item.hasElectronic}}">
          <text class="kv-key">电子存储位置</text>
          <text class="kv-val">{{item.electronicPath}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">容量占用</text>
          <text class="kv-val">{{item.capacityText}}（{{item.percentClamped}}%）</text>
        </view>
        <view class="kv" wx:if="{{item.note}}">
          <text class="kv-key">备注</text>
          <text class="kv-val">{{item.note}}</text>
        </view>

        <block wx:if="{{item.archives.length}}">
          <text class="detail-label">在架档案</text>
          <view class="tags">
            <text wx:for="{{item.archives}}" wx:for-item="archive" wx:key="archiveCode" class="tag">{{archive.archiveCode}}</text>
          </view>
        </block>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="secondary-button more-button" bindtap="loadMore"
            loading="{{loadingMore}}">加载更多</button>
  </block>
</view>
