.page-header {
  padding: 24rpx 32rpx 8rpx;
}

.form {
  padding: 0 32rpx 40rpx;
}

.field {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
}

.field .label {
  font-size: 26rpx;
  color: #5a6a7a;
  margin-bottom: 12rpx;
}

.picker,
.textarea {
  background: #fff;
  border: 1rpx solid #dfe6ee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1f2d3d;
}

.textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
}

.primary-button {
  margin-top: 40rpx;
  background: #3a7afe;
  color: #fff;
  border-radius: 12rpx;
}
