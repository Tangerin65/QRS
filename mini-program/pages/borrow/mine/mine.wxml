<view class="page">
  <view class="page-header">
    <text class="page-title">我的借阅</text>
    <button class="primary-button" size="mini" bindtap="goApply">申请借阅</button>
  </view>

  <view class="stats">
    <view class="stat"><text class="num">{{stats.total}}</text><text class="label">全部</text></view>
    <view class="stat"><text class="num">{{stats.lent}}</text><text class="label">在借</text></view>
    <view class="stat"><text class="num warn">{{stats.overdue}}</text><text class="label">逾期</text></view>
    <view class="stat"><text class="num">{{stats.pending}}</text><text class="label">待审批</text></view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state error">
    <text>{{error}}</text>
    <button class="secondary-button" size="mini" bindtap="relogin">重新登录</button>
  </view>
  <view wx:elif="{{rows.length === 0}}" class="state">还没有借阅记录</view>
  <view wx:else class="list">
    <view class="card borrow-item" wx:for="{{rows}}" wx:key="borrowId" data-id="{{item.borrowId}}" bindtap="goDetail">
      <view class="row">
        <text class="no">{{item.borrowNo}}</text>
        <text class="status status-{{item.borrowStatus}}">{{item.statusText}}</text>
      </view>
      <view class="title">{{item.archiveCode}}　{{item.archiveTitle}}</view>
      <view class="meta">借期：{{item.startDate}} 至 {{item.endDate}}</view>
      <view class="meta" wx:if="{{item.overdueText}}">
        <text class="overdue">{{item.overdueText}}</text>
      </view>
      <view class="actions" wx:if="{{item.borrowStatus === 'LENT'}}">
        <button class="mini-button" size="mini" data-id="{{item.borrowId}}" data-end="{{item.endDate}}" catchtap="renew">续借</button>
        <button class="mini-button danger" size="mini" data-id="{{item.borrowId}}" catchtap="giveBack">归还</button>
      </view>
    </view>
  </view>

  <button class="secondary-button" bindtap="goHome">返回工作台</button>
  <app-tabbar active="borrow"></app-tabbar>
</view>
