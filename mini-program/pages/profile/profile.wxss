.profile-header {
  padding: 0 0 24rpx;
}

.profile-name {
  display: block;
  color: #26354c;
  font-size: 32rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.profile-role {
  display: block;
  margin-top: 10rpx;
  color: #666;
  font-size: 23rpx;
  line-height: 1.6;
}

.profile-action {
  padding: 30rpx;
}

.spaced-button {
  margin-top: 18rpx;
}

.profile-action .primary-button, .profile-action .secondary-button {
  width: 100%;
}

.account-services {
  margin-top: 0;
  padding-bottom: 6rpx;
}

.account-services .section-heading {
  padding-bottom: 6rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  width: calc(100% - 56rpx);
  min-height: 88rpx;
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-info {
  padding: 0 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
  font-size: 25rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.row-hint {
  color: #666;
  font-size: 23rpx;
  text-align: right;
}

.inline-message {
  display: block;
  margin: 22rpx 8rpx;
  color: #aa7634;
  font-size: 24rpx;
  line-height: 1.7;
}
