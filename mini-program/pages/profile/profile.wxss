.profile-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 4rpx 46rpx;
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 106rpx;
  height: 106rpx;
  border: 6rpx solid #fff;
  border-radius: 32rpx;
  background: #dfeaff;
  color: #4779e8;
  font-size: 43rpx;
  font-weight: 600;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  color: #26354c;
  font-size: 36rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.profile-role {
  display: block;
  margin-top: 10rpx;
  color: #8390a3;
  font-size: 23rpx;
  line-height: 1.6;
}

.profile-badge {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border: 1rpx solid #dce4f1;
  border-radius: 8rpx;
  color: #7e8da2;
  font-size: 21rpx;
}

.profile-action {
  padding: 30rpx;
}

.profile-action-desc {
  display: block;
  margin: 14rpx 0 28rpx;
  color: #8a95a5;
  font-size: 24rpx;
  line-height: 1.7;
}

.spaced-button {
  margin-top: 18rpx;
}

.profile-action .primary-button, .profile-action .secondary-button {
  width: 100%;
}

.account-services {
  margin-top: 0;
  padding-bottom: 6rpx;
}

.account-services .section-heading {
  padding-bottom: 6rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: calc(100% - 56rpx);
  min-height: 116rpx;
  margin: 0 28rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-info {
  padding: 0 28rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
  font-size: 25rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.row-hint {
  color: #949dab;
  font-size: 23rpx;
  text-align: right;
}

.inline-message {
  display: block;
  margin: 22rpx 8rpx;
  color: #aa7634;
  font-size: 24rpx;
  line-height: 1.7;
}
