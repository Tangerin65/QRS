page {
  background: #f4f6f9;
  color: #273449;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: .5;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(144rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border: 1rpx solid #e1e4e8;
  border-radius: 6rpx;
}

.page-title {
  display: block;
  color: #233047;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.primary-button, .secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.primary-button {
  background: #2e65af;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #dbe3ef;
  background: #fff;
  color: #2e65af;
}

.connection-note {
  margin: 20rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 6rpx;
  background: #fff6e9;
  color: #9b6c30;
  font-size: 24rpx;
  line-height: 1.6;
}

.section {
  margin-top: 24rpx;
}

.section-heading {
  padding: 20rpx 24rpx 14rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #2a374b;
}

.row-arrow {
  flex-shrink: 0;
  color: #aeb7c4;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.row-copy {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.row-title {
  display: block;
  color: #344154;
  font-size: 27rpx;
  line-height: 1.5;
}

.service-note {
  display: block;
  margin: 28rpx 12rpx 0;
  color: #666;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

.empty-service {
  margin-top: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #344154;
  font-size: 29rpx;
  font-weight: 500;
}

.empty-service .secondary-button {
  width: 240rpx;
  margin: 24rpx auto 0;
  min-height: 76rpx;
}
