page {
  background: #f7f9fc;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(30, 64, 175, 0.06);
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  background: #2563eb;
  color: #ffffff;
}

.secondary-button {
  border: 2rpx solid #d9e2f3;
  background: #ffffff;
  color: #2563eb;
}

.page-title {
  display: block;
  margin: 4rpx 0 8rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  display: block;
  color: #718096;
  font-size: 26rpx;
  line-height: 1.6;
}

.connection-note {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 25rpx;
  line-height: 1.6;
}

button[disabled] { opacity: 0.55; }
.placeholder-page, .profile-page {
  background: linear-gradient(180deg, #eef5ff 0, #f7f9fc 420rpx);
}
.placeholder-hero { padding: 24rpx 8rpx 36rpx; }
