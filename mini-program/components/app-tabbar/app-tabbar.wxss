.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 10rpx 24rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5eaf3;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(15, 23, 42, 0.05);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}

.tab-icon {
  height: 42rpx;
  font-size: 40rpx;
  line-height: 42rpx;
}

.tab-label {
  line-height: 30rpx;
}
