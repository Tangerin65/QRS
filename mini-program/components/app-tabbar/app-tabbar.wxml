<view class="tabbar">
  <button wx:for="{{items}}" wx:key="key" class="tab-item {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="navigate" aria-label="{{item.label}}" aria-current="{{active === item.key}}">
    <image wx:if="{{!item.iconFailed}}" class="tab-icon" src="/assets/icons/tab-{{item.iconKey || item.key}}{{active === item.key ? '-active' : ''}}.png" mode="aspectFit" data-index="{{index}}" binderror="onIconError" />
    <text wx:else class="tab-icon tab-icon-fallback">{{item.label}}</text>
    <text class="tab-label">{{item.label}}</text>
  </button>
</view>
